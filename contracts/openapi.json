  "info": {
    "title": "Estuda Aí API",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LiveResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ReadyResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "SafeErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_INPUT",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "RATE_LIMITED",
              "UNAVAILABLE",
              "INTERNAL_ERROR"
            ]
          },
          "message": {
            "type": "string",
            "description": "Mensagem segura em português, sem detalhes internos."
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "ProfileResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "plan": {
            "type": "string",
            "enum": [
              "FREE"
            ]
          }
        },
        "required": [
          "id",
          "plan"
        ]
      },
      "CapabilitiesResponse": {
        "type": "object",
        "properties": {
          "advancedAi": {
            "type": "boolean",
            "example": false
          },
          "generatedQuestions": {
            "type": "boolean",
            "example": false
          },
          "advancedAnalytics": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "advancedAi",
          "generatedQuestions",
          "advancedAnalytics"
        ]
      },
      "EntitlementsResponse": {
        "type": "object",
        "properties": {
          "plan": {
            "type": "string",
            "enum": [
              "FREE"
            ]
          },
          "capabilities": {
            "$ref": "#/components/schemas/CapabilitiesResponse"
          }
        },
        "required": [
          "plan",
          "capabilities"
        ]
      }
    }
  }
}
