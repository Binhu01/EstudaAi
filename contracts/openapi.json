  "info": {
    "title": "Estuda Aí API",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LiveResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ReadyResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "SafeErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_INPUT",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "PAYLOAD_TOO_LARGE",
              "RATE_LIMITED",
              "UNAVAILABLE",
              "INTERNAL_ERROR"
            ]
          },
          "message": {
            "type": "string",
            "description": "Mensagem segura em português, sem detalhes internos."
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "ProfileResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "plan": {
            "type": "string",
            "enum": [
              "FREE"
            ]
          }
        },
        "required": [
          "id",
          "plan"
        ]
      },
      "CapabilitiesResponse": {
        "type": "object",
        "properties": {
          "steve": {
            "type": "boolean",
            "example": true
          },
          "advancedAi": {
            "type": "boolean",
            "example": false
          },
          "generatedQuestions": {
            "type": "boolean",
            "example": false
          },
          "advancedAnalytics": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "steve",
          "advancedAi",
          "generatedQuestions",
          "advancedAnalytics"
        ]
      },
      "LimitsResponse": {
        "type": "object",
        "properties": {
          "steveDailyMessages": {
            "type": "number",
            "example": 10,
            "minimum": 1
          }
        },
        "required": [
          "steveDailyMessages"
        ]
      },
      "EntitlementsResponse": {
        "type": "object",
        "properties": {
          "plan": {
            "type": "string",
            "enum": [
              "FREE"
            ]
          },
          "capabilities": {
            "$ref": "#/components/schemas/CapabilitiesResponse"
          },
          "limits": {
            "$ref": "#/components/schemas/LimitsResponse"
          }
        },
        "required": [
          "plan",
          "capabilities",
          "limits"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthSessionDto": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "readOnly": true
          },
          "refreshToken": {
            "type": "string",
            "readOnly": true
          },
          "expiresInSeconds": {
            "type": "number",
            "minimum": 1,
            "maximum": 86400
          }
        },
        "required": [
          "idToken",
          "refreshToken",
          "expiresInSeconds"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "maxLength": 8192,
            "writeOnly": true
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "EmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetAcceptedDto": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "accepted"
        ]
      },
      "ChatMessageDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1
          }
        },
        "required": [
          "role",
          "text"
        ]
      },
      "SteveInputDto": {
        "type": "object",
        "properties": {
          "topicId": {
            "type": "string",
            "enum": [
              "porcentagem",
              "interpretacao-texto",
              "ecologia"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "history": {
            "maxItems": 8,
            "description": "Até 12.000 caracteres no total.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessageDto"
            }
          }
        },
        "required": [
          "topicId",
          "message",
          "history"
        ]
      },
      "SourceDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "title",
          "url"
        ]
      },
      "QuotaDto": {
        "type": "object",
        "properties": {
          "remaining": {
            "type": "number",
            "minimum": 0
          },
          "resetAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "remaining",
          "resetAt"
        ]
      },
      "SteveReplyDto": {
        "type": "object",
        "properties": {
          "topicId": {
            "type": "string",
            "enum": [
              "porcentagem",
              "interpretacao-texto",
              "ecologia"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "refused",
              "incomplete"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 16000
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceDto"
            }
          },
          "quota": {
            "$ref": "#/components/schemas/QuotaDto"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "topicId",
          "status",
          "text",
          "sources",
          "quota",
          "requestId"
        ]
      }
    }
  }
}
