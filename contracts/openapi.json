    "/v1/steve/messages": {
      "post": {
        "operationId": "SteveController_reply",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SteveInputDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SteveReplyDto"
                }
              }
            }
          },
          "400": {
            "description": "Assunto, mensagem ou histórico inválidos."
          },
          "401": {
            "description": "Entre na sua conta."
          },
          "413": {
            "description": "Mensagem muito grande."
          },
          "429": {
            "description": "Aguarde ou volte após a renovação da cota diária (resetAt)."
          },
          "503": {
            "description": "Steve temporariamente indisponível."
          }
        },
        "security": [
