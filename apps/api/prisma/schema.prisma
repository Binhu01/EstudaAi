generator client {
  provider = "prisma-client-js"
  engineType = "client"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid()) @db.Uuid
  externalId String @unique @db.VarChar(128)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  goals StudyGoal[]
  aiReservations AiQuotaReservation[]
}
model AiDailyUsage {
  dayUTC DateTime @db.Date
  scope String @db.VarChar(64)
  count Int @default(0)
  @@id([dayUTC, scope])
}
model AiQuotaReservation {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  dayUTC DateTime @db.Date
  releasedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, dayUTC])
}
model StudyGoal {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  name String @db.VarChar(120)
  category String @db.VarChar(40)
  examDate DateTime? @db.Date
  timezone String @default("America/Sao_Paulo") @db.VarChar(80)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  contextKey String? @db.VarChar(40)
  dailyTarget Int @default(10)
  answers StudyAnswer[]
  errors StudyQuestionError[]
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, id])
  @@unique([userId, contextKey])
  @@index([userId, createdAt, id])
}
model StudyAnswer {
  id String @id @db.Uuid
  userId String @db.Uuid
  goalId String @db.Uuid
  topicId String @db.VarChar(100)
  contentVersion Int
  questionId String @db.VarChar(100)
  optionIndex Int
  source String @db.VarChar(8)
  correct Boolean
  receivedAt DateTime @db.Timestamptz(3)
  ordinal BigInt @unique @default(autoincrement())
  goal StudyGoal @relation(fields: [userId, goalId], references: [userId, id], onDelete: Cascade)
  @@index([userId, goalId, receivedAt], map: "StudyAnswer_context_date_idx")
  @@index([userId, goalId, topicId, contentVersion], map: "StudyAnswer_context_topic_idx")
}
model StudyQuestionError {
  userId String @db.Uuid
  goalId String @db.Uuid
  topicId String @db.VarChar(100)
  contentVersion Int
  questionId String @db.VarChar(100)
  wrongCount Int
  firstWrongAt DateTime @db.Timestamptz(3)
  lastWrongAt DateTime @db.Timestamptz(3)
  lastAnswerAt DateTime @db.Timestamptz(3)
  lastOptionIndex Int
  status String @db.VarChar(8)
  goal StudyGoal @relation(fields: [userId, goalId], references: [userId, id], onDelete: Cascade)
  @@id([userId, goalId, topicId, contentVersion, questionId])
  @@index([userId, goalId, status, lastWrongAt(sort: Desc), topicId, contentVersion, questionId], map: "StudyQuestionError_context_status_date_idx")
}
