# Copie para .env e configure valores locais. Nunca versionar credenciais reais.
NODE_ENV=development
PORT=3001

# Processo Node no host: preencha uma URL com a senha percent-encoded.
# Exemplo de formato: postgresql://estuda_ai:SENHA@127.0.0.1:5432/estuda_ai
DATABASE_URL=

# Projeto Firebase real e chave Web de autenticação (usada só pelo backend).
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
# Caminho absoluto fora do repositório para execução Node no host.
GOOGLE_APPLICATION_CREDENTIALS=
# Mesmo arquivo no host, montado como secret somente na API do Compose.
# Windows: use barras /, por exemplo C:/caminho-externo/firebase-admin.json.
FIREBASE_ADMIN_CREDENTIALS_FILE=

# Origens exatas, separadas por vírgula; sem / final ou wildcard.
# Em produção, todas as origens devem usar HTTPS.
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:4174,http://127.0.0.1:4174

# Compose. API_PORT expõe a API no host; PORT vale para execução Node no host.
API_PORT=3001
POSTGRES_PORT=5432
POSTGRES_DB=estuda_ai
POSTGRES_USER=estuda_ai
# Use senha aleatória longa. Neste Compose, use caracteres seguros para URL
# (letras/números/-/_), pois ela também compõe DATABASE_URL no container.
POSTGRES_PASSWORD=

# Steve: chave e modelo juntos habilitam IA. Nunca enviar a chave ao Flutter.
OPENAI_API_KEY=
STEVE_MODEL=
STEVE_DAILY_LIMIT=10
STEVE_GLOBAL_DAILY_LIMIT=1000
