{
  "name": "estuda-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "deepmerge-ts": "8.0.2",
    "gaxios": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "build": "npm run build -w apps/api",
    "test": "npm test -w apps/api",
    "test:pg:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/test-postgres.ps1",
    "dev:api": "npm run dev -w apps/api",
    "db:generate": "npm run db:generate -w apps/api",
    "db:deploy": "npm run db:deploy -w apps/api",
    "preview": "node tools/preview.mjs",
    "openapi": "npm run build && node tools/openapi.mjs",
    "test:visual": "node tools/verify-web.mjs",
    "test:study": "node tools/verify-study.mjs",
    "test:contests": "node tools/verify-contests.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
